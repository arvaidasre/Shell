<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Shell.Manager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Shell Manager"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:ConnectionId='2' x:Name="DragBar" Height="48" Background="Transparent">
            <TextBlock Text="Shell Manager" VerticalAlignment="Center" Margin="16,0,0,0"
                       FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Border>

        <ScrollViewer Grid.Row="1" Padding="24,8,24,24">
            <StackPanel Spacing="16" MaxWidth="640" HorizontalAlignment="Stretch">

                <StackPanel Spacing="4">
                    <TextBlock x:ConnectionId='21' x:Name="TitleText" Text="Shell" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock x:ConnectionId='22' x:Name="SubtitleText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <InfoBar x:ConnectionId='5' x:Name="Notice" IsOpen="False" Severity="Informational" />

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Status" FontWeight="SemiBold" FontSize="15" />
                        <StackPanel Spacing="4">
                            <TextBlock x:ConnectionId='18' x:Name="RegisteredText" />
                            <TextBlock x:ConnectionId='19' x:Name="TakeoverText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:ConnectionId='20' x:Name="ConfigText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:ConnectionId='15' x:Name="RegisterButton" Content="Register" Style="{StaticResource AccentButtonStyle}"                              />
                            <Button x:ConnectionId='16' x:Name="UnregisterButton" Content="Unregister"                                />
                            <Button x:ConnectionId='17' x:Name="RestartButton" Content="Restart Explorer"                             />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Language &amp; theme" FontWeight="SemiBold" FontSize="15" />
                        <ComboBox x:ConnectionId='13' x:Name="LanguageBox" Header="Menu language" HorizontalAlignment="Stretch"
                                                                                 >
                            <ComboBoxItem Content="English" Tag="en" />
                            <ComboBoxItem Content="Lietuvių" Tag="lt" />
                            <ComboBoxItem Content="Русский" Tag="ru" />
                        </ComboBox>
                        <ComboBox x:ConnectionId='14' x:Name="ThemeBox" Header="Theme preset" HorizontalAlignment="Stretch"
                                                                              >
                            <ComboBoxItem Content="Default" Tag="default" />
                            <ComboBoxItem Content="Mica" Tag="mica" />
                            <ComboBoxItem Content="OLED black" Tag="oled" />
                            <ComboBoxItem Content="Light" Tag="light" />
                        </ComboBox>
                        <TextBlock Text="Language and theme apply after Explorer restarts."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Tools" FontWeight="SemiBold" FontSize="15" />
                        <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" ItemWidth="220">
                            <Button x:ConnectionId='7' Content="Open config folder"                                Margin="0,0,8,8" HorizontalAlignment="Stretch" />
                            <Button x:ConnectionId='8' Content="Backup config"                            Margin="0,0,8,8" HorizontalAlignment="Stretch" />
                            <Button x:ConnectionId='9' Content="Check for updates"                            Margin="0,0,8,8" HorizontalAlignment="Stretch" />
                            <Button x:ConnectionId='10' Content="Start Menu shortcut"                              Margin="0,0,8,8" HorizontalAlignment="Stretch" />
                            <Button x:ConnectionId='11' Content="Run check"                           Margin="0,0,8,8" HorizontalAlignment="Stretch" />
                            <Button x:ConnectionId='12' Content="Report issue"                           Margin="0,0,8,8" HorizontalAlignment="Stretch" />
                        </VariableSizedWrapGrid>
                    </StackPanel>
                </Border>

                <HyperlinkButton x:ConnectionId='6' Content="arvaidasre/Shell on GitHub"                              HorizontalAlignment="Left" />

            </StackPanel>
        </ScrollViewer>

        <ContentDialog x:ConnectionId='3' x:Name="ReportDialog" Title="Shell check" PrimaryButtonText="Close" DefaultButton="Primary">
            <ScrollViewer MaxHeight="400">
                <TextBlock x:ConnectionId='4' x:Name="ReportText" IsTextSelectionEnabled="True" FontFamily="Consolas" TextWrapping="Wrap" />
            </ScrollViewer>
        </ContentDialog>
    </Grid>
</Window>

