<Page
    x:Class="Shell.Manager.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="16" Padding="24,8,24,24">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Application" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox
                            MinWidth="200"
                            SelectedItem="{x:Bind ViewModel.AppTheme, Mode=TwoWay}">
                            <x:String>System</x:String>
                            <x:String>Light</x:String>
                            <x:String>Dark</x:String>
                        </ComboBox>
                        <Button Content="Apply" Command="{x:Bind ViewModel.ApplyAppThemeCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="About" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}"
                        Style="{StaticResource BodyTextBlockStyle}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.ConfigPath, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        TextWrapping="Wrap" />
                    <HyperlinkButton
                        Content="GitHub releases"
                        Command="{x:Bind ViewModel.OpenReleasesCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
